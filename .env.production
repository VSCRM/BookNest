# "true"  -> use the bundled sample dataset (mock/bookData.ts), no backend needed
# "false" -> talk to the real BookNest backends (default)
VITE_USE_MOCK=false

# Rails backend (book catalog)
VITE_API_URL=http://localhost:8080/api/v1

# Spring Boot backend (authentication: login/register/JWT)
VITE_AUTH_URL=http://localhost:9000/api/auth

# Root of the same Spring Boot auth-service (no /api/auth suffix). Used
# only for the "Sign in with Google" button, which redirects the whole
# page to {VITE_AUTH_ROOT_URL}/oauth2/authorization/google.
VITE_AUTH_ROOT_URL=http://localhost:9000

# Artificial delay for the mock data path only (ms) — simulates network latency.
VITE_MOCK_DELAY_MS=600

# EmailJS — password-reset code delivery. Leave blank to fall back to
# displaying the code on-screen (fine for local development).
# Get your keys at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_k4icqw4
VITE_EMAILJS_TEMPLATE_ID=template_qbd1rdz
VITE_EMAILJS_PUBLIC_KEY=UZBuJLHmKP47_5Iby
