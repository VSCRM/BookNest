{
	"name": "booknest-shop",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "BookNest storefront — book catalog, search, saved books and account (React 19 + TS + React Router 7).",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"deploy": "npm run build && gh-pages -d dist"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"axios": "^1.17.0",
		"bcrypt-ts": "^8.0.1",
		"crypto-js": "^4.2.0",
		"lucide-react": "^1.16.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.17.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/crypto-js": "^4.2.2",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"eslint": "^10.2.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.5.0",
		"gh-pages": "^6.3.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.4.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
